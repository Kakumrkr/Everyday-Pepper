# Copy to .env (git-ignored) to override local defaults. Never put real credentials in this file.

# docker-compose.yml. POSTGRES_USER is the superuser that owns the schema and runs migrations;
# api and worker use the APP_DB_* login role, which row-level security applies to (ADR-0010).
POSTGRES_USER=pepper
POSTGRES_PASSWORD=pepper_dev
POSTGRES_DB=pepper
APP_DB_USER=pepper_service
APP_DB_PASSWORD=pepper_service_dev

# `pnpm db:migrate` (with `pnpm dev`): migrations run as the owner, then provision DATABASE_URL's role.
MIGRATION_DATABASE_URL=postgres://pepper:pepper_dev@localhost:5432/pepper
# apps/api and apps/worker when run with `pnpm dev` (infra from `docker compose up postgres redis mailpit`)
DATABASE_URL=postgres://pepper_service:pepper_service_dev@localhost:5432/pepper
REDIS_URL=redis://localhost:6379

# apps/api: sign-in (Better Auth, ADR-0012). AUTH_SECRET: at least 32 random characters,
# e.g. `openssl rand -base64 32`; changing it signs everyone out and breaks stored TOTP secrets.
# AUTH_BASE_URL: the origin the browser uses (the web app); https outside localhost.
AUTH_SECRET=local-dev-only-auth-secret-not-for-real-use
AUTH_BASE_URL=http://localhost:3000

# apps/api and apps/worker: email. The api sends the booking page's codes at once (ADR-0022);
# the worker sends queued emails from the outbox (ADR-0024). Mailpit's SMTP port in development;
# read the inbox at http://localhost:8025. Empty: the booking page cannot send codes (503), and
# queued emails wait.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Pepper <bookings@pepper.localhost>

# apps/api and apps/worker: seals queued emails (ADR-0024); both need the same value. At least
# 32 random characters, e.g. `openssl rand -base64 32`; changing it gives up emails still queued.
OUTBOX_SECRET=local-dev-only-outbox-secret-not-for-real-use
# apps/worker: how often the outbox relay looks for due messages (milliseconds, default 1000).
OUTBOX_POLL_MS=
# apps/worker: how often due booking reminders are queued (milliseconds, default 60000, at most
# 240000) and how often old rows are cleaned up (default 86400000; it also runs at start-up).
REMINDER_POLL_MS=
CLEANUP_INTERVAL_MS=

# apps/api and apps/worker: Web Push for the installed app (ADR-0026). The api needs only the
# public key; the worker needs both. Generate a pair with `npx web-push generate-vapid-keys`
# (the pair below is local-only and public: never use it for anything real). Both empty: no
# notifications are offered or sent. VAPID_SUBJECT: who push services may contact.
VAPID_PUBLIC_KEY=BOaUPqJhSDXmacBl4Z6i_HCIBlCN8COqIGiY2jpVS8WxSO0bs5v6zR4YigbzbnlF45tJsCNBHQaAle1oMU1q2Ic
VAPID_PRIVATE_KEY=80nrfo5XabVQkQ6ud0KhaU-laJ8PtGLU7qw7oHlFyac
VAPID_SUBJECT=mailto:bookings@pepper.localhost

# apps/api and apps/worker: logging and telemetry (empty = off)
LOG_LEVEL=info
DEPLOYMENT_ENVIRONMENT=local
RELEASE=
# Sentry project DSN (errors only). Free tier; leave empty in development.
SENTRY_DSN=
# OTLP/HTTP collector base URL for traces, e.g. Grafana Cloud; auth goes in the headers variable
# (`Authorization=Basic <base64 instance:token>`). Leave empty in development.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# apps/web (server side)
API_INTERNAL_URL=http://localhost:4000
