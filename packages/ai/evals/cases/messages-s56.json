    "id": "no-show-before-start-refused",
    "set": "scheduling",
    "description": "A visit that hasn't started can't be a no-show: the domain refuses, nothing changes, and the reply says why (AC-W2-7).",
    "now": "2026-11-02T12:00:00Z",
    "timeZone": "America/New_York",
    "actor": {
      "role": "owner"
    },
    "turns": [
