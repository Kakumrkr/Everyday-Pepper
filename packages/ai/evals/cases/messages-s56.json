[
  {
    "id": "late-message-waits-for-ok",
    "set": "autonomy",
    "description": "A message to a client asks first by default (message.client, S56a): \"running late\" waits on a card with the domain's words, and the reply never says it was sent (AC-W2-5).",
    "now": "2026-11-02T12:00:00Z",
    "timeZone": "America/New_York",
    "actor": {
      "role": "owner"
    },
    "turns": [
      {
        "action": {
          "advanceClock": 1875
        }
      },
      {
        "user": "Let Maria know I'm running about 15 minutes behind"
      }
    ],
    "expect": {
      "toolCalls": [
        {
          "name": "find_clients",
          "arguments": {
            "name": {
              "$regex": "maria"
            }
          }
        },
        {
          "name": "send_client_message",
          "arguments": {
            "kind": "running_late",
            "minutesLate": 15
          }
        }
      ],
      "replyMatches": ["approv(e|al)|card"],
      "replyMustNotMatch": ["\\b(I've|I have) (sent|emailed|told)\\b"],
      "actions": {
        "proposed": ["send_client_message"],
        "done": []
      }
    }
  },
