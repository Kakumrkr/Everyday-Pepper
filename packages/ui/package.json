{
  "name": "@pepper/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Design system: the approved tokens (light and dark), the Tailwind theme and shared React components for the PWA and the booking page.",
  "type": "module",
  "exports": {
    ".": {
      "@pepper/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./src/theme.css"
  },
  "files": [
    "dist",
    "src/theme.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@pepper/config": "workspace:*",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "4.13.0",
    "fast-check": "^4.10.2",
    "jsdom": "28.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@pepper/contracts": "workspace:*"
  }
}
