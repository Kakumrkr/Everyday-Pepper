{
  "name": "@pepper/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Design system: the approved tokens (light and dark), the Tailwind theme and shared React components for the PWA and the booking page.",
  "type": "module",
  "exports": {
    ".": {
      "@pepper/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./src/theme.css"
  },
  "files": [
    "dist",
    "src/theme.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@pepper/config": "workspace:*",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "react": "^19.3.1",
    "vitest": "^5.0.5"
  }
}
