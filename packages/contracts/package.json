{
  "name": "@pepper/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Zod schemas, events and card contracts (the only way modules talk to each other).",
  "type": "module",
  "exports": {
    ".": {
      "@pepper/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@pepper/config": "workspace:*",
    "@vitest/coverage-v8": "^5.0.5",
    "fast-check": "^4.10.2",
    "vitest": "^5.0.5"
  }
}
