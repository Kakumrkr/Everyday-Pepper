{
  "name": "@pepper/runtime",
  "version": "0.0.0",
  "private": true,
  "description": "Process wiring shared by the NestJS apps (api, worker): config, logging, telemetry, health and connections.",
  "type": "module",
  "exports": {
    ".": {
      "@pepper/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./instrument": {
      "@pepper/source": "./src/instrument.ts",
      "types": "./dist/instrument.d.ts",
      "default": "./dist/instrument.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@pepper/contracts": "workspace:*",
    "@pepper/core": "workspace:*",
    "@pepper/db": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/instrumentation-express": "^0.71.1",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-ioredis": "^0.71.0",
    "@opentelemetry/instrumentation-pg": "^0.76.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/node": "^11.8.0",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@pepper/config": "workspace:*",
    "@pepper/testing": "workspace:*",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/testing": "^12.1.3",
    "@swc/core": "^1.16.18",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.3.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
