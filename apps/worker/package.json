{
  "name": "@pepper/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Background worker (NestJS): outbox relay, reminders, briefings, sync and imports. Serves only health endpoints over HTTP.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node --env-file-if-exists=../../.env --import ./dist/instrument.js dist/main.js\"",
    "start": "node --import ./dist/instrument.js dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@pepper/ai": "workspace:*",
    "@pepper/appointments": "workspace:*",
    "@pepper/contracts": "workspace:*",
    "@pepper/core": "workspace:*",
    "@pepper/db": "workspace:*",
    "@pepper/runtime": "workspace:*",
    "@pepper/templates": "workspace:*",
    "bullmq": "6.3.11",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "web-push": "3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.3",
    "@pepper/config": "workspace:*",
    "@pepper/testing": "workspace:*",
    "@swc/core": "^1.16.18",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "3.6.4",
    "@vitest/coverage-v8": "^5.0.5",
    "supertest": "^7.3.1",
    "tsc-watch": "^7.2.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
