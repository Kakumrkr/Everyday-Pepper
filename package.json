{
  "name": "pepper",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:integration": "turbo run test:integration",
    "lint": "node --max-old-space-size=6144 node_modules/eslint/bin/eslint.js . --max-warnings=0 --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "lint:fix": "node --max-old-space-size=6144 node_modules/eslint/bin/eslint.js . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check . --cache --cache-strategy content --cache-location node_modules/.cache/prettier/.prettier-cache",
    "check": "node scripts/check.mjs",
    "test:e2e": "turbo run build --filter=@pepper/e2e^... --output-logs=errors-only && pnpm --filter @pepper/e2e test:e2e",
    "db:migrate": "turbo run build --filter=@pepper/db --output-logs=errors-only && pnpm --filter @pepper/db migrate",
    "db:generate": "pnpm --filter @pepper/db generate"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.2",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
